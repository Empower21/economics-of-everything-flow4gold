# Keep your existing .env. Never paste secrets into browser code or workflow exports.
PORT=3000
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_URL=
N8N_EVENTS_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENAI_MODEL=gpt-4o-mini
# Set to the exact public HTTPS origin at deployment, e.g. https://your-app.example
PUBLIC_ORIGIN=
# Set only when deployment has exactly one trusted reverse proxy.
TRUST_PROXY_HOPS=0
